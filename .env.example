# ---------------------------------------------------------------------------
# HireOrHigher backend environment variables (names only — no real values).
# Copy to `.env` at the repo root and fill in. The backend validates all
# required variables on startup and fails fast, naming any missing one.
# ---------------------------------------------------------------------------

# Gemini API keys — one dedicated key per module (Section 3.1 of the spec).
# Required. Never share a single key across modules.
GEMINI_API_KEY_RESUME_PARSER=
GEMINI_API_KEY_GAP_MAPPER=
GEMINI_API_KEY_INTERVIEW_GENERATOR=
GEMINI_API_KEY_PROFILE_OPTIMIZER=

# Supabase — required.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides (sensible defaults exist in backend/app/config.py).
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
GEMINI_TIMEOUT_SECONDS=
BACKEND_CORS_ORIGINS=
MAX_UPLOAD_MB=
UPLOAD_RATE_LIMIT_PER_HOUR=
